# Copie para .env (fora do git) e preencha. Nunca coloque credenciais reais neste arquivo.

# --- API ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origem do painel liberada no CORS
CORS_ORIGIN=http://localhost:4200
# Prefixo da API visto pelo navegador (nginx e proxy do ng serve usam /api)
API_PUBLIC_PREFIX=/api

# --- Banco (PostgreSQL) ---
DATABASE_URL=postgresql://pokeidle_hub:troque-esta-senha@localhost:5432/pokeidle_hub

# --- Autenticação do painel ---
# Hash argon2id da senha do painel. Gere com: npm run hash-password -w @pokeidle-hub/api
# Ao colar no .env, envolva o valor em aspas simples (o hash contém "$").
HUB_ADMIN_PASSWORD_HASH='$argon2id$cole-aqui-o-hash-gerado'
# Segredo dos JWT: pelo menos 32 caracteres aleatórios (ex.: openssl rand -base64 48)
HUB_JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Ponte e histórico ---
# Snapshots aceitos por conta por minuto (HTTP e WebSocket da ponte)
INGEST_RATE_PER_MINUTE=60
# Dias de histórico de snapshots mantidos
SNAPSHOT_RETENTION_DAYS=30

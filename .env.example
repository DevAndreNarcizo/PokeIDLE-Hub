# Copie para .env (fora do git) e preencha. Nunca coloque credenciais reais neste arquivo.

# --- API ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Origem do painel liberada no CORS
CORS_ORIGIN=http://localhost:4200

# --- Banco (PostgreSQL) ---
DATABASE_URL=postgresql://pokeidle_hub:troque-esta-senha@localhost:5432/pokeidle_hub
